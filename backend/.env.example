# PNB Backend - Environment variables (example, no real secrets committed)
NODE_ENV=production
PORT=8080

# Deployment region constraint per TZ section 1/3.2/6 (us-east1 mandatory for Cloud Run defaults)
GCP_REGION=us-east1
GCP_PROJECT_ID=REPLACE_ME

# Firebase / Firestore (values injected via Secret Manager in real deployment, never hardcoded)
FIREBASE_PROJECT_ID=REPLACE_ME

# Service-to-service auth (Sub-step C.2) - optional until Iteration F/H.1 mounts requireGoogleServiceAuth
SERVICE_AUDIENCE=REPLACE_ME
TRUSTED_SERVICE_ACCOUNTS=REPLACE_ME_COMMA_SEPARATED_EMAILS

# GitHub App (Sub-step F.1) - GITHUB_APP_PRIVATE_KEY MUST be injected via
# Secret Manager as a mounted env var on Cloud Run at deploy time, per TZ
# section 5 bootstrap step 8. NEVER commit the real PEM value to this file
# or to any file in the repository - this line exists only as a schema
# placeholder for local development against a throwaway test App.
GITHUB_APP_ID=REPLACE_ME
GITHUB_APP_PRIVATE_KEY=REPLACE_ME_PEM_VIA_SECRET_MANAGER_ONLY
GITHUB_APP_INSTALLATION_ID=REPLACE_ME