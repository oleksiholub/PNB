# --- PNB Backend runtime configuration (NO SECRETS IN THIS FILE) ---
# Actual values are injected via Cloud Run environment variables / Secret Manager references.
# This file documents required variable NAMES ONLY. Never commit real values.

NODE_ENV=production
PORT=8080

# GCP project / region (must remain us-east1 per TZ budget constraint)
GCP_PROJECT_ID=REPLACE_ME
GCP_REGION=us-east1

# Firebase project config (values, not secrets, safe to template)
FIREBASE_PROJECT_ID=REPLACE_ME

# Secret Manager resource names (NOT the secret values themselves)
SECRET_GITHUB_APP_PRIVATE_KEY=projects/REPLACE_ME/secrets/github-app-private-key/versions/latest
SECRET_GITHUB_APP_ID=projects/REPLACE_ME/secrets/github-app-id/versions/latest
SECRET_GITHUB_APP_INSTALLATION_ID=projects/REPLACE_ME/secrets/github-app-installation-id/versions/latest

# Operational limits (Always Free budget guardrails)
FIRESTORE_DAILY_READ_BUDGET=45000
FIRESTORE_DAILY_WRITE_BUDGET=18000
LOG_LEVEL=info
