{
  "manifest_version": 3,
  "name": "PNB - Perplexity Neural Bridge",
  "version": "0.5.0",
  "description": "Captures Perplexity chat context and code artifacts for cross-chat memory and GitHub push automation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.perplexity.ai/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "classic"
  },
  "content_scripts": [
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": [
        "src/selector_config_manager.js",
        "src/passive_logging_controller.js",
        "src/dom_observer.js",
        "src/injection_engine.js",
        "src/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/config/selector-config.default.json"],
      "matches": ["https://www.perplexity.ai/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}