{
  "manifest_version": 3,
  "name": "PNB - Perplexity Neural Bridge",
  "version": "0.2.0",
  "description": "Captures Perplexity chat context and code artifacts for cross-chat memory and GitHub push automation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.perplexity.ai/*"
  ],
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["src/dom_observer.js", "src/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}